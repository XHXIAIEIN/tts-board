      "id": "母亲：在哪",
      "role": "母亲",
      "text": "Where are you? It's almost midnight!",
      "gloss": "你在哪儿？都快半夜了！"
    },
    {
      "id": "儿子：朋友家",
      "role": "儿子",
      "text": "At a friend's place. I'm fine.",
      "gloss": "在朋友家。我没事。"
    },
    {
      "id": "母亲：十点",
      "role": "母亲",
      "text": "You said you'd be home by ten!",
      "gloss": "你说过十点前回家的！"
    },
    {
      "id": "儿子：对不起",
      "role": "儿子",
      "text": "I know. I'm sorry.",
      "gloss": "我知道。对不起。"
    },
    {
      "id": "旁白：沉默",
      "role": "旁白",
      "text": "For a moment, neither of them spoke."
    },
    {
      "id": "母亲：回来",
      "role": "母亲",
      "text": "Just... come home safe, okay?",
      "gloss": "平安回来就好，好吗？"
    }
  ],
